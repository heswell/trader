{
  "name": "trader",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable trading front-end and simulated trading backend built on Vuu",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/showcase",
    "apps/portal-config",
    "apps/features/*"
  ],
  "scripts": {
    "preinstall": "node ./scripts/only-bun.cjs",
    "postinstall": "bun ./scripts/link-vuu-websocket.ts",
    "link:vuu": "bun ./scripts/link-vuu-websocket.ts",
    "certs": "bun ./scripts/make-certs.ts",
    "dev": "bun ./scripts/dev.ts",
    "dev:showcase": "bun run --filter @heswell/trading-showcase dev",
    "dev:trading-server": "bun run --filter @heswell/oms start",
    "build": "bun run --filter './apps/features/*' build",
    "typecheck": "bun scripts/vuu-types.ts && tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:server && bun run test:ui",
    "test:server": "bun test ./packages/trading-schemas ./packages/exchange-sim ./packages/oms",
    "test:ui": "bun test --preload ./scripts/dom-test-setup.ts ./packages/trading-test-data ./packages/trading-ui",
    "types:vuu": "bun scripts/vuu-types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.5.3"
  },
  "packageManager": "bun@1.3.14"
}
