{
  "name": "trader",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable trading front-end and simulated trading backend built on Vuu",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/showcase",
    "apps/portal-config",
    "apps/portal-host",
    "apps/features/*"
  ],
  "scripts": {
    "preinstall": "node ./scripts/only-bun.cjs",
    "postinstall": "bun ./scripts/link-vuu-websocket.ts",
    "link:vuu": "bun ./scripts/link-vuu-websocket.ts",
    "certs": "bun ./scripts/make-certs.ts",
    "dev": "bun ./scripts/start-all.ts",
    "dev:showcase": "bun run --filter @heswell/trading-showcase dev",
    "dev:trading-server": "bun run --filter @heswell/oms start",
    "build": "bun run features:sync && bun run --filter @heswell/trading-portal-host --filter @heswell/trading-features build",
    "typecheck": "bun scripts/vuu-types.ts && tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:server && bun run test:ui",
    "test:server": "bun test ./packages/trading-schemas ./packages/exchange-sim ./packages/oms",
    "test:ui": "bun test --preload ./scripts/dom-test-setup.ts ./packages/trading-test-data ./packages/trading-ui",
    "types:vuu": "bun scripts/vuu-types.ts",
    "start:all": "bun ./scripts/start-all.ts",
    "features:sync": "bun ./scripts/features/sync-build-config.ts",
    "features:check": "bun ./scripts/features/sync-build-config.ts --check",
    "keycloak:realm": "bun ./scripts/stack/keycloak-realm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.5.3"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@vuu-ui/core": "4.0.0-alpha.21",
    "@vuu-ui/grid-layout": "4.0.0-alpha.21",
    "@vuu-ui/vuu-codemirror": "4.0.0-alpha.21",
    "@vuu-ui/vuu-context-menu": "4.0.0-alpha.21",
    "@vuu-ui/vuu-data-editing": "4.0.0-alpha.21",
    "@vuu-ui/vuu-data-local": "4.0.0-alpha.21",
    "@vuu-ui/vuu-data-react": "4.0.0-alpha.21",
    "@vuu-ui/vuu-data-remote": "4.0.0-alpha.21",
    "@vuu-ui/vuu-data-types": "4.0.0-alpha.21",
    "@vuu-ui/vuu-datatable": "4.0.0-alpha.21",
    "@vuu-ui/vuu-filter-parser": "4.0.0-alpha.21",
    "@vuu-ui/vuu-filter-types": "4.0.0-alpha.21",
    "@vuu-ui/vuu-filters": "4.0.0-alpha.21",
    "@vuu-ui/vuu-icons": "4.0.0-alpha.21",
    "@vuu-ui/vuu-layout": "4.0.0-alpha.21",
    "@vuu-ui/vuu-notifications": "4.0.0-alpha.21",
    "@vuu-ui/vuu-popups": "4.0.0-alpha.21",
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.21",
    "@vuu-ui/vuu-shell": "4.0.0-alpha.21",
    "@vuu-ui/vuu-table": "4.0.0-alpha.21",
    "@vuu-ui/vuu-table-extras": "4.0.0-alpha.21",
    "@vuu-ui/vuu-table-types": "4.0.0-alpha.21",
    "@vuu-ui/vuu-ui-controls": "4.0.0-alpha.21",
    "@vuu-ui/vuu-utils": "4.0.0-alpha.21"
  }
}
