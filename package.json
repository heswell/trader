{
  "name": "trader",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable trading front-end and simulated trading backend built on Vuu",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/showcase",
    "apps/portal-config",
    "apps/portal-host",
    "apps/features/*"
  ],
  "scripts": {
    "preinstall": "node ./scripts/only-bun.cjs",
    "certs": "bun ./scripts/make-certs.ts",
    "dev": "bun ./scripts/start-all.ts",
    "dev:showcase": "bun run --filter @heswell/trading-showcase dev",
    "dev:trading-server": "bun run --filter @heswell/oms start",
    "build": "bun run features:sync && bun run --filter @heswell/trading-portal-host --filter @heswell/trading-features build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:server && bun run test:ui",
    "test:server": "bun test ./packages/trading-schemas ./packages/exchange-sim ./packages/oms ./packages/persistence ./packages/trading-test-data ./apps/features/trading",
    "test:ui": "bun test --preload ./scripts/dom-test-setup.ts ./packages/trading-ui ./apps/portal-host",
    "start:all": "bun ./scripts/start-all.ts",
    "features:sync": "bun ./scripts/features/sync-build-config.ts",
    "features:check": "bun ./scripts/features/sync-build-config.ts --check",
    "docs:api": "bun ./scripts/docs/api-reference.ts",
    "docs:check": "bun ./scripts/docs/api-reference.ts --check && bun ./scripts/docs/check-links.ts",
    "keycloak:realm": "bun ./scripts/stack/keycloak-realm.ts",
    "e2e:persistence": "bun ./scripts/e2e/persistence.ts",
    "e2e:resilience": "bun ./scripts/e2e/resilience.ts",
    "e2e:palette": "bun ./scripts/e2e/palette.ts",
    "perf:ws": "bun ./packages/perf/src/ws-load.ts",
    "perf:ui": "bun ./packages/perf/src/ui-profile.ts",
    "perf:ladder": "bun ./packages/perf/src/ladder-budget.ts",
    "persistence:reset": "bun ./scripts/persistence-reset.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "20.14.5",
    "@heswell/trading-persistence": "workspace:*",
    "@heswell/vuu-portal": "^2.3.0",
    "@heswell/vuu-server": "^4.3.0",
    "@heswell/vuu-table": "^1.0.3",
    "@types/bun": "1.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.5.3"
  },
  "packageManager": "bun@1.3.14"
}
