# Optional overrides for `bun run start:all` (bun loads .env automatically).
# Every port / URL is listed in docs/portal-integration.md, e.g.:
# TRADER_PORTAL_HTTPS_PORT=8543
# TRADER_PORTAL_WS_PORT=8191
# Optional: directory containing a built portal host (index.html + config.json) to serve on :5001.
# VUU_PORTAL_HOST_DIR=../vuu/vuu-ui/dist_portal/portal-host
