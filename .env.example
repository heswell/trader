# Path to a checkout of https://github.com/heswell/vuu-websocket (with `bun install` run in it).
# Used by `bun run link:vuu` to link @heswell/vuu-server, @heswell/service-utils, @heswell/vuu-portal.
VUU_WEBSOCKET_DIR=../vuu-websocket
# Optional: directory containing a built portal host (index.html + config.json) to serve on :5001.
# VUU_PORTAL_HOST_DIR=../vuu/vuu-ui/dist_portal/portal-host
