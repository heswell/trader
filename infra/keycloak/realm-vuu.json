{
  "realm": "vuu",
  "enabled": true,
  "displayName": "Trader (dev)",
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 36000,
  "clients": [
    {
      "clientId": "vuu-portal",
      "name": "Vuu portal host",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5100/*"
      ],
      "webOrigins": [
        "http://localhost:5100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-vuu-portal-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vuu-portal-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-trader-trading-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trader-trading-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vuu-portal-server",
      "name": "Vuu portal server",
      "enabled": true,
      "publicClient": false,
      "secret": "vuu-portal-local-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-vuu-portal-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vuu-portal-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trader-trading-server",
      "name": "Trader trading server (exchange-sim + OMS)",
      "enabled": true,
      "publicClient": false,
      "secret": "trader-trading-local-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-trader-trading-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trader-trading-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "vuu-portal": [
        {
          "name": "trading-access",
          "clientRole": true
        },
        {
          "name": "trading-execute-access",
          "clientRole": true
