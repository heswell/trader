{
  "extends": "../../portal-build.base.json",
  "version": 1,
  "target": "remote-module",
  "paths": {
    "entry": "./src/index.tsx",
    "htmlTemplate": "./public/index.html",
    "output": "./dist",
    "publicPath": "auto"
  },
  "html": {
    "title": "Trading feature (standalone)"
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {}
  },
  "moduleFederation": {
    "name": "tradingFeature",
    "dts": false,
    "exposes": {}
  },
  "cssInline": {
    "include": ["/packages/trading-ui/", "/apps/features/trading/"]
  }
}
