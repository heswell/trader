{
  "extends": "../portal-build.base.json",
  "version": 1,
  "target": "host",
  "paths": {
    "assetPrefix": "/",
    "htmlTemplate": "./public/index.html",
    "output": "./dist",
    "entries": {
      "remote": "./src/index.tsx"
    },
    "preEntry": "@vuu-ui/vuu-theme/index.css"
  },
  "manifest": {
    "filename": "./config.json",
    "remote": {
      "authUrl": "https://localhost:8180",
      "restUrl": "https://localhost:8543/api/authn",
      "websocketUrl": "wss://localhost:8191/websocket-portal"
    }
  },
  "moduleFederation": {
    "name": "host",
    "remoteType": "module",
    "remotes": {}
  },
  "cssInline": {
    "include": ["/packages/trading-ui/"]
  }
}
